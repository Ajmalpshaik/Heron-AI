<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Reads which Revit API members an assembly REFERENCES, and checks each one
    against another release. Deliberately NOT part of the solution build: it is
    a tool that talks ABOUT Heron, not part of Heron.

    net8.0 and no Revit reference of its own - it reads assemblies as data.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>ApiSurface</AssemblyName>
    <RootNamespace>Heron.Tools.ApiSurface</RootNamespace>
    <!-- The repo-wide x64/Platform settings are for Revit; this is a plain tool. -->
    <Platform>AnyCPU</Platform>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!--
      RUNS ON A NEWER RUNTIME THAN IT TARGETS, and this is not a nicety.
      Without it a net8.0 app refuses to start unless the .NET 8 runtime is
      installed specifically: "You must install or update .NET to run this
      application ... The following frameworks were found: 10.0.12".

      Measured 2026-09-17 on a container carrying dotnet-sdk-10.0 and
      nothing else - which is the SDK Heron needs anyway, because Revit
      2027 is net10.0-windows (docs/16). So the machine best set up to
      build Heron was the one that could not run the tool that checks it.
    -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.0" />
  </ItemGroup>

</Project>
