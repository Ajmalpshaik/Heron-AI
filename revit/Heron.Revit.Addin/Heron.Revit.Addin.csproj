<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Revit add-in. The ONLY project that references Autodesk.Revit.

    Revit API assemblies are Autodesk's and are NOT redistributable
    (docs/07 section 4). They are referenced with Private=false so they are
    never copied to the output - Revit supplies them at runtime.

    Two ways to resolve them:

      1. NuGet (default). Per-version packages.
      2. A local Revit install, if NuGet is unavailable or you prefer the
         exact DLLs from your machine:

           dotnet build -p:RevitVersion=2024 -p:RevitApiDir="C:\Program Files\Autodesk\Revit 2024"
  -->

  <PropertyGroup>
    <TargetFramework>$(HeronTfm)</TargetFramework>
    <RootNamespace>Heron.Revit.Addin</RootNamespace>
    <AssemblyName>Heron.Revit.Addin</AssemblyName>
    <UseWPF Condition="'$(HeronTfm)' != 'net472' AND '$(HeronTfm)' != 'net48'">true</UseWPF>

    <!--
      An add-in has to CARRY its dependencies. Revit loads this assembly from
      a folder of its own and resolves nothing on its behalf, so a NuGet
      dependency left out of the output is a FileNotFoundException at
      OnStartup - which costs the whole add-in, not just the feature.

      Without this the Roslyn assemblies stayed in the package cache and only
      their localized resource folders were copied, which looks like the
      package deployed.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Heron.Bridge\Heron.Bridge.csproj" />
  </ItemGroup>

  <!--
    D-28's in-process C# scripting runtime - the thing that lets a fragment
    reach Revit at all.

    CHECKED BEFORE IT WAS ADDED, because loading a second Roslyn inside a host
    that already has one is the classic way this fails: Revit 2024 ships NO
    Microsoft.CodeAnalysis assemblies in its install, and the running process
    had none loaded. Re-check that before assuming it holds for another
    release - Dynamo carries its own, and a conflict here is an add-in that
    dies at OnStartup.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.8.0" />
  </ItemGroup>

  <!-- Option 1: NuGet, when RevitApiDir is not supplied. -->
  <ItemGroup Condition="'$(RevitApiDir)' == ''">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Option 2: local Revit install. -->
  <ItemGroup Condition="'$(RevitApiDir)' != ''">
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(HeronTfm)' == 'net472' OR '$(HeronTfm)' == 'net48'">
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Heron.addin" CopyToOutputDirectory="PreserveNewest" />
    <!-- Ribbon icons, loaded from disk beside the assembly rather than embedded:
         an icon can then be replaced without a rebuild, and IconLoader can fall
         back to no picture instead of throwing during OnStartup. -->
    <None Update="Resources\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
