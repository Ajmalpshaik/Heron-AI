# =============================================================================
#  NEVER COMMIT — client data, project knowledge, models
#  This repository becomes public. Anything committed here is permanent:
#  forks propagate and GitHub caches. See docs/17-open-source-and-distribution.md
# =============================================================================

# Revit files — models, families, templates.
# Test models must be SYNTHETIC and go under tests/models/ (exception below).
*.rvt
*.rfa
*.rte
*.rft
*.rvt.*
*.0001.rvt
*.slog
*.dwg
*.dwf
*.nwc
*.nwd
*.ifc
!tests/models/**/*.rvt
!tests/models/**/*.rfa

# Heron data class — belongs to the user, never to the repository
/workspace/
/data/
/Memory/
/Projects/
/Company/
/Community/
/Logs/
/Cache/
/Backup/
heron-workspace/
*.heron-db

# Knowledge stores and indexes (derived — rebuildable, never authoritative)
*.sqlite
*.sqlite3
*.db
*.duckdb
*.lance
/vector-index/
/embeddings/

# Audit logs — contain project information
audit-*.jsonl
*.audit.jsonl

# Revit journals — contain file paths and project names
journal.*.txt
/journals/

# =============================================================================
#  Secrets
# =============================================================================
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
*.snk
secrets.json
appsettings.Local.json
credentials.*

# =============================================================================
#  Build output
# =============================================================================

# .NET
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
*.userprefs
.vs/
TestResults/
*.nupkg

# Autodesk API assemblies — never redistribute
RevitAPI.dll
RevitAPIUI.dll
AdWindows.dll

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# Node
node_modules/
.next/
.nuxt/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# =============================================================================
#  Editors / OS / misc
# =============================================================================
.vscode/
.idea/
*.swp
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*.log
*.tmp
*.bak
tmp/
temp/

# Revit reference assemblies fetched by tools/check-api-surface.py.
# Autodesk's, cached locally, never committed.
tools/api-surface/.assemblies/

# Generated pages. Both are rebuilt from the repository in a second, both are
# several hundred KB, and tools/README says the reason neither is committed -
# which was true of the intent and not of the rules until 2026-09-08.
agent-map.html
fragment-catalog.html
build/compile-results.json
