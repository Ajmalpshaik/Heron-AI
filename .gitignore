# Revit reference assemblies fetched by tools/check-api-surface.py.
# Autodesk's, cached locally, never committed.
tools/api-surface/.assemblies/

# Each release's full public surface, dumped from those assemblies.
# ~3 MB a release and regenerated in seconds once the assemblies are
# cached. The DIGEST of what changed between them is committed -
# tools/api-surface/changes.json - because that is the answer, and
# regenerating it needs 264 MB of downloads and a .NET SDK.
tools/api-surface/.surface/

# Generated pages. Each is rebuilt from the repository in a second, and
# tools/README says the reason none of them is committed - which was true of
# the intent and not of the rules until 2026-09-08.
agent-map.html
fragment-catalog.html
skill-catalog.html
api-reference.html
contract-reference.html
build/compile-results.json

# Proof drafts and run records. A draft is evidence waiting for a person, and
# `accept` DELETES it as it writes the proof into the fragment - so a draft in
# a commit is either unjudged evidence or evidence already banked elsewhere.
# Neither belongs in history. Only the README explaining the folder is tracked.
brain/proof-drafts/*.yaml
brain/proof-drafts/runs/

# THE BUILT INSTALLER, KEPT WHERE IT CAN BE FOUND.
# A single-file publish of platform/Heron.Installer.App, put here because
# platform/Heron.Installer.App/bin/x64/Debug/ is not somewhere anybody should
# have to dig to find an installer. It sits beside the add-in projects it
# installs, which is where the owner asked for it on 2026-09-21. It is BUILD
# OUTPUT and is never committed - what a downloader gets is the release asset,
# which is Stage 5.
/revit/HeronInstaller.exe
