<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Proves D-141 - one model, one chat at a time - WITHOUT Revit.

    The source-linking pattern Heron.KeepQuestion.TestHost uses, for the same
    reason: HeronModelHold.cs and HeronConversation.cs name no Autodesk type -
    the clock and the quiet time are passed in - so they are linked here BY
    SOURCE rather than through a project reference. Referencing
    Heron.Revit.Addin would drag in RevitAPI.dll and make the testable half
    untestable on any machine without Revit.

    One copy of the rule, linked: a second copy written to test the first is
    how two halves come to agree on paper and not in a running model.

        Run it with `dotnet run`, pointed at this folder, passing
        -p:RevitVersion=2024. (XML comments cannot carry a double
        hyphen, so the flag is spelled out rather than shown.)
        tests/test_model_hold.py builds and runs it.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(HeronTfm)</TargetFramework>
    <RootNamespace>Heron.ModelHold.TestHost</RootNamespace>
    <AssemblyName>Heron.ModelHold.TestHost</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\revit\Heron.Revit.Addin\HeronModelHold.cs"
             Link="HeronModelHold.cs" />
    <Compile Include="..\..\revit\Heron.Revit.Addin\HeronConversation.cs"
             Link="HeronConversation.cs" />
  </ItemGroup>

</Project>
