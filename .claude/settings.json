{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$CLAUDE_PROJECT_DIR\"; [ -f \"$d/.claude/skills/heron-session/bin/session_line.py\" ] || d=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -f \"$d/.claude/skills/heron-session/bin/session_line.py\" ] || exit 0; python \"$d/.claude/skills/heron-session/bin/session_line.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$CLAUDE_PROJECT_DIR\"; [ -f \"$d/.claude/skills/heron-session/bin/local_only.py\" ] || d=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -f \"$d/.claude/skills/heron-session/bin/local_only.py\" ] || exit 0; python \"$d/.claude/skills/heron-session/bin/local_only.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$([ -f \"$CLAUDE_PROJECT_DIR/.claude/skills/heron-guard/bin/heron_guard.py\" ] && printf %s \"$CLAUDE_PROJECT_DIR\" || git rev-parse --show-toplevel)/.claude/skills/heron-guard/bin/heron_guard.py\"",
            "timeout": 30,
            "statusMessage": "Checking the adapter boundary..."
          }
        ]
      },
      {
        "matcher": "^Bash$|^mcp__.+__(merge_pull_request|update_pull_request|enable_pr_auto_merge)$",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$CLAUDE_PROJECT_DIR\"; [ -f \"$d/.claude/skills/heron-session/bin/main_moved.py\" ] || d=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -f \"$d/.claude/skills/heron-session/bin/main_moved.py\" ] || exit 0; python \"$d/.claude/skills/heron-session/bin/main_moved.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
